{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/como-technologies/llm-wiki/schemas/v0.1.0/worked-example.json",
  "title": "Worked example type",
  "description": "A concrete end-to-end example demonstrating a guide, decision, or concept (kb-spec §2 target class).",
  "type": "object",
  "required": ["title", "type", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Stable opaque page identifier (ULID, tool-generated)."
    },
    "title": { "type": "string", "description": "Display name" },
    "type": { "type": "string", "description": "Page type from registry" },
    "status": {
      "type": "string",
      "enum": ["active", "draft", "stub", "generated"],
      "description": "Content lifecycle state (engine vocabulary)"
    },
    "summary": { "type": "string", "description": "One-line scope" },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date the example was created"
    },
    "last_updated": { "type": "string", "description": "ISO 8601 date of last substantive edit" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "owner": { "type": "string", "description": "Person, team, or agent responsible" },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Certainty of this page's content."
    },
    "citations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Pinned path@commit evidence refs (non-edge; interim until llm-wiki#8)."
    },
    "demonstrates": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ids/slugs of the pages this example demonstrates"
    },
    "relates_to": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ids/slugs of related pages"
    },
    "superseded_by": {
      "type": "string",
      "description": "Id (preferred) or slug of the replacement page"
    }
  },
  "x-wiki-types": {
    "worked-example": "Concrete end-to-end demonstration"
  },
  "x-graph-edges": {
    "demonstrates": { "relation": "demonstrates", "direction": "outgoing" },
    "relates_to": { "relation": "relates-to", "direction": "outgoing" },
    "superseded_by": { "relation": "superseded-by", "direction": "outgoing" }
  },
  "additionalProperties": false
}
